{
	"name": "tpc-studio",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"db:migrate": "tsx --env-file=.env scripts/db-migrate.ts",
		"db:seed": "tsx --env-file=.env scripts/db-seed.ts",
		"test:rls": "vitest run --config vitest.rls.config.ts"
	},
	"devDependencies": {
		"@lucide/svelte": "^0.525.0",
		"@sveltejs/adapter-cloudflare": "^7.2.10",
		"@sveltejs/kit": "^2.70.4",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"postgres": "^4.1.1",
		"sass": "^1.108.2",
		"svelte": "^5.59.1",
		"svelte-check": "^4.7.8",
		"tsx": "^4.23.15",
		"typescript": "^5.9.3",
		"vite": "^7.3.8",
		"vitest": "^3.2.7"
	},
	"dependencies": {
		"@supabase/ssr": "^0.12.7",
		"@supabase/supabase-js": "^2.119.2"
	}
}
