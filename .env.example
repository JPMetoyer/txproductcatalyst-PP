# Copy to .env and fill in. Never commit .env.
# Supabase → Project Settings → API Keys

# Public (safe in the browser; access is enforced by row-level security)
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# SECRET — server-only. Used for admin actions (create accounts, reset passwords, revoke sessions).
# Never prefix with PUBLIC_, never paste into chat, never commit.
SUPABASE_SECRET_KEY=sb_secret_...

# SECRET — only used by `npm run db:migrate`. Supabase → Connect → Session pooler.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:YOUR-PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres
